# === LUNA env ===
# URL pública del sitio (en Vercel: https://luna-store-wheat.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcionales: la tienda funciona sin ellas ---

# Postgres (Neon). Solo lo usa `npm run seed` / `npm run db:push`; la app no lo lee.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Stripe (modo prueba). Necesarias cuando se conecte el pago en /checkout.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
